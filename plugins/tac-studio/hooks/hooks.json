{
  "description": "Spare-cycles nudge on startup; on every session start, exposes the session id to tacctl (for per-piece token estimates)",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/nudge.py\"",
            "timeout": 5
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/session_env.py\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
